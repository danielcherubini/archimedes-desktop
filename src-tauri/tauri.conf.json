{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Archimedes",
  "version": "0.1.0",
  "identifier": "codes.archimedes.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Archimedes",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDQjlDRTdEMzUzMzk2QjMKUldTemxqTTFmYzY1ekJqYWVhODV6Rlk3NGtDcnlXMytkdFJlVXBtNVVLS2tIaVU5SGR3TDhvcHAK",
      "endpoints": [
        "https://github.com/danielcherubini/archimedes/releases/latest/download/latest.json"
      ]
    }
  }
}
